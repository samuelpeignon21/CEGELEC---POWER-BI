	column IsCurrentWeek
		formatString: 0
		lineageTag: 44601ba4-389e-4cb0-9515-0bfaf897f38d
		summarizeBy: none
		isNameInferred
		sourceColumn: [IsCurrentWeek]

		annotation SummarizationSetBy = Automatic

	partition Tab_date = calculated
		mode: import
		source =
				
				VAR MinDate = DATE(2024,1,1)
				VAR MaxDate = EOMONTH(TODAY(), 0)
				RETURN
				ADDCOLUMNS (
				    CALENDAR ( MinDate, MaxDate ),
				
				    "Date classique",
				        LOWER(FORMAT([Date], "ddd")) & UNICHAR(10) &
				        FORMAT([Date], "dd mmmm"),
				
				    // 🔹 Base
				    "Année", YEAR ( [Date] ),
				    "Mois Num", MONTH ( [Date] ),
				    "Jour", DAY ( [Date] ),
				
				    // 🔹 Formats utiles
				    "Année Mois", FORMAT ( [Date], "YYYYMM" ),
				    "Mois Nom", FORMAT ( [Date], "MMMM" ),
				    "Mois Court", FORMAT ( [Date], "MMM" ),
				
				    // 🔹 Trimestre
				    "Trimestre", "T" & FORMAT ( [Date], "Q" ),
				
				    // 🔹 Semaine
				    "Semaine Num", WEEKNUM ( [Date], 2 ),
				    "Semaine ISO", "W" & FORMAT(WEEKNUM ([Date], 21 ), "00"),
				
				    // 🔹 Année + semaine ISO
				    "Année-Semaine ISO",
				        VAR An = YEAR ( [Date] )
				        VAR Sem = WEEKNUM ( [Date], 2 )
				        VAR SemISO = WEEKNUM ( [Date], 21 )
				        RETURN
				            IF (
				                SemISO < 5 && Sem > 50, An + 1,
				                IF ( SemISO > 50 && Sem < 5, An - 1, An )
				            )
				            & "-W" & FORMAT ( SemISO, "00" ),
				
				    // 🔹 Jour semaine
				    "Jour Semaine Num", WEEKDAY ( [Date], 2 ),
				    "Jour Semaine Nom", FORMAT ( [Date], "dddd" ),
				
				    // 🔹 Week-end / ouvré
				    "Jour Ouvré",
				        IF ( WEEKDAY ( [Date], 2 ) <= 5, "Ouvré", "Week-end" ),
				    "IsCurrentWeek",
				    VAR TodayDate = TODAY()
				    VAR CurrentYearWeek =
				        YEAR(TodayDate) * 100 + WEEKNUM(TodayDate, 2)
				    VAR RowYearWeek =
				        YEAR([Date]) * 100 + WEEKNUM([Date], 2)
				    RETURN
				    IF(RowYearWeek = CurrentYearWeek, 1, 0)
				)

	annotation PBI_Id = 8e5d692687c14e59b15ae3d9950a01d4

