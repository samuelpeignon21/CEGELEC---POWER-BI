	column IsCurrentWeek
		formatString: 0
		lineageTag: c6b754d9-c9bd-4e5e-9ec2-5e07825d0ca8
		summarizeBy: sum
		isNameInferred
		sourceColumn: [IsCurrentWeek]

		annotation SummarizationSetBy = Automatic

	partition TAB_Date = calculated
		mode: import
		source =
				
				VAR MinDate = DATE(2025,1,6)
				VAR MaxDate = EOMONTH(TODAY(), 0)
				RETURN
				ADDCOLUMNS (
				    CALENDAR ( MinDate, MaxDate ),
				
				    "Date simplifié",
				        LOWER(FORMAT([Date], "ddd")) & UNICHAR(10) &
				        FORMAT([Date], "dd"),
				
				    // 🔹 Base
				    "Année", YEAR ( [Date] ),
				    "Mois Num", MONTH ( [Date] ),
				    "Jour", DAY ( [Date] ),
				
				    // 🔹 Formats utiles
				    "Année Mois", FORMAT ( [Date], "YYYYMM" ),
				    "Mois Nom", UPPER(LEFT(FORMAT([Date], "MMMM"), 1)) & RIGHT(FORMAT([Date], "MMMM"), LEN(FORMAT([Date], "MMMM")) - 1),
				    "Mois Court", FORMAT ( [Date], "MMM" ),
				
				    // 🔹 Trimestre
				    "Trimestre", "T" & FORMAT ( [Date], "Q" ),
				
				    // 🔹 Semaine
				    "Semaine Num", WEEKNUM ( [Date], 2 ),
				    "Semaine ISO", "S" & FORMAT(WEEKNUM ([Date], 21 ), "00"),
				
				    // 🔹 Année + semaine ISO
				    "Année-Semaine ISO",
				        VAR An = YEAR ( [Date] )
				        VAR Sem = WEEKNUM ( [Date], 2 )
				        VAR SemISO = WEEKNUM ( [Date], 21 )
				        RETURN
				            IF (
				                SemISO < 5 && Sem > 50, An + 1,
				                IF ( SemISO > 50 && Sem < 5, An - 1, An )
				            )
				            & "-W" & FORMAT ( SemISO, "00" ),
				
				    // 🔹 Jour semaine
				    "Jour Semaine Num", WEEKDAY ( [Date], 2 ),
				    "Jour Semaine Nom", FORMAT ( [Date], "dddd" ),
				
				    // 🔹 Week-end / ouvré
				    "Jour Ouvré",
				        IF ( WEEKDAY ( [Date], 2 ) <= 5, "Ouvré", "Week-end" ),
				    "IsCurrentWeek",
				    VAR TodayDate = TODAY()
				    VAR CurrentYearWeek =
				        YEAR(TodayDate) * 100 + WEEKNUM(TodayDate, 2)
				    VAR RowYearWeek =
				        YEAR([Date]) * 100 + WEEKNUM([Date], 2)
				    RETURN
				    IF(RowYearWeek = CurrentYearWeek, 1, 0)
				)

	annotation PBI_Id = 021d24c58b314013a94ce5382d8b8f0d

