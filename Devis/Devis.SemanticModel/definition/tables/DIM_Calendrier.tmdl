		isNameInferred
		sourceColumn: [Jour Ouvré]

		annotation SummarizationSetBy = Automatic

	partition DIM_Calendrier = calculated
		mode: import
		source =
				VAR MinDate = DATE ( YEAR ( MIN ( FACT_Devis[Date de création] ) ), 1, 1 )
				VAR MaxDate =
				    DATE (
				        MAX ( MAX ( YEAR ( MAX ( FACT_Devis[Date de relance] ) ), YEAR ( MAX ( FACT_Devis[Date de création] ) ) ), YEAR ( TODAY () ) ),
				        12,
				        31
				    )
				RETURN
				ADDCOLUMNS (
				    CALENDAR ( MinDate, MaxDate ),
				    "Année", YEAR ( [Date] ),
				    "Mois Num", MONTH ( [Date] ),
				    "Mois Nom", FORMAT ( [Date], "MMMM" ),
				    "Mois Court", FORMAT ( [Date], "MMM" ),
				    "Année Mois", FORMAT ( [Date], "YYYY-MM" ),
				    "Trimestre", "T" & FORMAT ( [Date], "Q" ),
				    "Semaine ISO", WEEKNUM ( [Date], 21 ),
				    "Jour Semaine Num", WEEKDAY ( [Date], 2 ),
				    "Jour Semaine Nom", FORMAT ( [Date], "dddd" ),
				    "Jour Ouvré", IF ( WEEKDAY ( [Date], 2 ) <= 5, "Ouvré", "Week-end" )
				)

	annotation PBI_Id = 066aa32490c84229bb25dfde75ab0079
